# -----------------------------------------------------------------------------
# Zephyr — variables de entorno
# Copia este archivo como .env.local (desarrollo) y configúralas también en
# Vercel → Project → Settings → Environment Variables (producción).
# -----------------------------------------------------------------------------

# Supabase → Project Settings → API
# URL del proyecto (pública).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave anon/publishable (pública; RLS protege los datos).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role / secret. SOLO servidor: nunca la expongas con NEXT_PUBLIC_.
# Se usa para crear reservas, gestionar citas por enlace privado y el cron.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio, sin barra final (SEO, sitemap, Open Graph, enlaces "Mi cita").
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (gratis) — anti-bots en el formulario de reserva.
# Si se dejan vacías, el widget no se muestra y la verificación se omite
# (el honeypot y el límite de reservas pendientes por WhatsApp siguen activos).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secreto del cron diario (/api/cron/maintenance). Vercel lo envía como
# "Authorization: Bearer <CRON_SECRET>". Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Opcional, solo pruebas: Postgres real (p. ej. `supabase start` local) para la
# prueba de concurrencia con conexiones paralelas. NO uses la base de producción.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
